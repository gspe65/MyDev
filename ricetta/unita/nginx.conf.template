worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout  65;

    server {
        listen       127.0.0.1:8080;   # solo locale: nessuna richiesta del firewall, nessun privilegio
        server_name  localhost;

        root   "__MYDEV__/www";
        index  index.html;

        location / {
            try_files $uri $uri/ =404;
        }

        location /flask/ {
            proxy_pass         http://127.0.0.1:5000/;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
        }

        location /fastapi/ {
            proxy_pass         http://127.0.0.1:5001/;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
        }
    }

    server {
        listen       127.0.0.1:8443 ssl;   # solo locale, come sopra
        server_name  localhost;

        ssl_certificate      "__MYDEV__/nginx/ssl/mydev.crt";
        ssl_certificate_key  "__MYDEV__/nginx/ssl/mydev.key";

        root   "__MYDEV__/www";
        index  index.html;

        location / {
            try_files $uri $uri/ =404;
        }

        location /flask/ {
            proxy_pass         http://127.0.0.1:5000/;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
        }

        location /fastapi/ {
            proxy_pass         http://127.0.0.1:5001/;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
        }
    }
}
