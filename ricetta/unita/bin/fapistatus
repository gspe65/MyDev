#!/bin/bash
: "${MYDEV:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export MYDEV
PIDFILE="$MYDEV/bin/.fastapi.pid"
if [ ! -f "$PIDFILE" ]; then
    echo "FastAPI non e' in esecuzione (nessun file PID)."
    exit 1
fi
PID=$(cat "$PIDFILE")
if kill -0 "$PID" 2>/dev/null; then
    echo "FastAPI e' in esecuzione (PID $PID)."
else
    echo "FastAPI non e' in esecuzione (processo $PID non trovato)."
    rm -f "$PIDFILE"
fi
